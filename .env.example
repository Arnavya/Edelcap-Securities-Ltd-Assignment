# FinFlow Reasoning Engine — environment configuration
# Copy to `.env` and fill in GROQ_API_KEY (or set FINFLOW_PROVIDER=mock to run with no key).

# Provider: groq (default) | mock
FINFLOW_PROVIDER=groq

# Required when FINFLOW_PROVIDER=groq
GROQ_API_KEY=

# Model used for investigation + gap + learning (Groq default)
FINFLOW_MODEL=llama-3.3-70b-versatile

# Model used for the LLM judges (defaults to FINFLOW_MODEL if unset)
FINFLOW_JUDGE_MODEL=llama-3.3-70b-versatile

# SQLite database path for generated artifacts
FINFLOW_DB=finflow.db

# Retrieval: top-k evidence items per source before merge
FINFLOW_RETRIEVAL_K=4
